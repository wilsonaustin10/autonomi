Example implementation of script storage:
```javascript
const fs = require('fs');
const path = require('path');
const { v4: uuidv4 } = require('uuid');

/**
 * File-based script repository implementation
 */
class FileScriptRepository {
  constructor(storageDir = './data/scripts') {
    this.storageDir = storageDir;
    // Ensure storage directory exists
    if (!fs.existsSync(storageDir)) {
      fs.mkdirSync(storageDir, { recursive: true });
    }
  }
  
  /**
   * Save a script to the repository
   * @param {object} scriptData - Script data object
   * @param {string} [scriptId] - Optional ID (generates UUID if not provided)
   * @returns {Promise<string>} - The script ID
   */
  async saveScript(scriptData, scriptId = null) {
    // Generate an ID if one wasn't provided
    const id = scriptId || `script_${uuidv4()}`;
    
    // Add metadata if not present
    if (!scriptData.metadata) {
      scriptData.metadata = {
        createdAt: new Date().toISOString(),
        version: 1
      };
    }
    
    const filePath = path.join(this.storageDir, `${id}.json`);
    await fs.promises.writeFile(
      filePath, 
      JSON.stringify(scriptData, null, 2)
    );
    
    return id;
  }
  
  /**
   * Retrieve a script from the repository
   * @param {string} scriptId - Script ID
   * @returns {Promise<object|null>} - Script data or null if not found
   */
  async getScript(scriptId) {
    const filePath = path.join(this.storageDir, `${scriptId}.json`);
    if (!fs.existsSync(filePath)) return null;
    
    const data = await fs.promises.readFile(filePath, 'utf-8');
    return JSON.parse(data);
  }
  
  /**
   * List all available scripts
   * @returns {Promise<Array>} - Array of script metadata
   */
  async listScripts() {
    const files = await fs.promises.readdir(this.storageDir);
    const scriptFiles = files.filter(file => file.endsWith('.json'));
    
    const scripts = [];
    for (const file of scriptFiles) {
      try {
        const data = await fs.promises.readFile(
          path.join(this.storageDir, file), 
          'utf-8'
        );
        const scriptData = JSON.parse(data);
        scripts.push({
          id: file.replace('.json', ''),
          title: scriptData.title || 'Untitled Script',
          description: scriptData.description || '',
          metadata: scriptData.metadata || {}
        });
      } catch (error) {
        console.error(`Error reading script file ${file}:`, error);
      }
    }
    
    return scripts;
  }
}

module.exports = FileScriptRepository;
```

