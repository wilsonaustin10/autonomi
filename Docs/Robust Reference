// Focus management implementation
function manageFocus(context) {
  // Clear any existing focus
  if (document.activeElement) {
    document.activeElement.blur();
  }
  
  switch (context) {
    case 'chat':
      // Focus on chat input when returning to chat context
      chatInput.focus();
      break;
    
    case 'script-editor':
      // Focus on code editor when in editing mode
      codeEditor.focus();
      break;
      
    case 'execution':
      // Focus on control panel during execution
      runControlPanel.focus();
      break;
      
    case 'human-handoff':
      // Focus on continue button during human handoff
      continueButton.focus();
      break;
  }
  
  // Log focus change for debugging
  console.log(`Focus changed to: ${context}`);
}

// Set up focus management event listeners
document.addEventListener('keydown', (event) => {
  // Alt+C to focus chat
  if (event.altKey && event.key === 'c') {
    event.preventDefault();
    manageFocus('chat');
  }
  
  // Alt+E to focus editor
  if (event.altKey && event.key === 'e') {
    event.preventDefault();
    manageFocus('script-editor');
  }
  
  // Alt+R to focus run controls
  if (event.altKey && event.key === 'r') {
    event.preventDefault();
    manageFocus('execution');
  }
});

// Ensure chat input is focused after operations complete
function completeOperation() {
  // Reset UI state
  statusElement.textContent = '';
  chatInput.disabled = false;
  sendButton.disabled = false;
  
  // Return focus to chat input for seamless conversation flow
  manageFocus('chat');
}
```

