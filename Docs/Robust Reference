Example robust click function generated for scripts:
```javascript
async function robustClick(page, selector, options = {}) {
  const { timeout = 5000, retries = 3, debug = true } = options;
  
  for (let attempt = 1; attempt <= retries; attempt++) {
    try {
      if (debug) console.log("Attempting to click " + selector + " (attempt " + attempt + "/" + retries + ")");
      
      // First check if element exists at all
      const elementExists = await page.$(selector) !== null;
      if (!elementExists) {
        if (debug) console.log("Element " + selector + " does not exist in the DOM");
        if (attempt < retries) {
          await page.waitForTimeout(500);
          continue;
        }
        throw new Error("Element " + selector + " does not exist in the DOM after " + retries + " attempts");
      }
      
      // Check if element is visible
      const isVisible = await page.isVisible(selector, { timeout: 1000 }).catch(() => false);
      if (!isVisible) {
        if (debug) console.log("Element " + selector + " exists but is not visible");
        if (attempt < retries) {
          await page.waitForTimeout(500);
          continue;
        }
        throw new Error("Element " + selector + " exists but is not visible after " + retries + " attempts");
      }
      
      // Try to scroll element into view
      await page.evaluate((sel) => {
        const element = document.querySelector(sel);
        if (element) element.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }, selector);
      
      await page.waitForTimeout(500); // Wait for scroll to complete
      
      // Check if element is clickable (not covered/obscured)
      // ... [additional checks]
      
      // Finally attempt the click
      await page.click(selector, { timeout });
      if (debug) console.log("Successfully clicked " + selector);
      return true;
    } catch (error) {
      if (debug) console.log("Error clicking " + selector + ": " + error.message);
      if (attempt < retries) {
        await page.waitForTimeout(500);
        continue;
      }
      throw error;
    }
  }
}
```

